rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for Admin role
    function isAdmin() {
      return exists(/admins/$(request.auth.uid));
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ELIMIKA: Courses
    match /courses/{courseId} {
      allow read: if isAuthenticated() && resource.data.is_active == 1;
      allow write: if isAdmin();
    }

    // ELIMIKA: Lessons
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ELIMIKA: Course Enrollments
    match /course_enrollments/{enrollmentId} {
      allow read, update: if isOwner(resource.data.driverId) || isAdmin();
      allow create: if isOwner(request.resource.data.driverId);
      allow delete: if isAdmin();
    }

    // ELIMIKA: Quizzes
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ELIMIKA: Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow read: if isOwner(resource.data.driverId) || isAdmin();
      allow create: if isOwner(request.resource.data.driverId);
      allow update, delete: if isAdmin();
    }

    // JITESTI: Categories
    match /jitesti-categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // JITESTI: Tests
    match /tests/{testId} {
      allow read, write: if isAdmin();
    }

    // JITESTI: Questions
    match /questions/{questionId} {
      allow write: if isAdmin();
      allow read: if isAuthenticated() && !("correctAnswerIndex" in resource.data);
    }

    // Payments: Shared between modules
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.status == 'Pending';
      allow update: if isOwner(resource.data.userId)
                      && resource.data.status == 'Pending'
                      && request.resource.data.status == 'Completed'
                      && request.resource.data.selcomTransactionId != null;
    }

    // Test Attempts: Primarily for JITESTI
    match /test_attempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.status == 'not-started'
                      && get(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.status == 'Completed';
      
      allow update: if isOwner(resource.data.userId)
                      && resource.data.status == 'in-progress'
                      && request.time < resource.data.expiresAt
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.testId == resource.data.testId
                      && (request.resource.data.score == null || resource.data.score == null);

      allow update: if false; 
    }

    // Certificates: Shared between modules
    match /certificates/{certId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.driverId) || isAdmin();
      // Allow creation if the user is the owner and has passed a test (either JITESTI or ELIMIKA quiz)
      allow create: if (isOwner(request.resource.data.userId) || isOwner(request.resource.data.driverId));
    }

    // Audit Logs: Read-only for admins, written by Cloud Functions
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
