rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rule: Logged-in users can read their own user document.
    // This is required to get a user's roles.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Note: You may want to add write/create rules later.
    }

    // Rule: Logged-in users can read their own admin profile.
    // This is required for SuperAdmin login to work.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Note: You may want to add write/create rules later.
    }

    match /jitesti-categories/{categoryId} {
      allow read: if request.auth != null;
    }

    // --- IMPORTANT ---
    // Add the rest of your collection rules below.
    // For example, if you have a 'drivers' collection:
    //
    // match /drivers/{driverId} {
    //   allow read, write: if request.auth != null; // Example: allow any logged-in user
    // }

  }
}
